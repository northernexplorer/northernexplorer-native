{
  "cli": {
    "version": ">= 20.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SERVER_URL_WEB": "https://api.northernexplorer.org",
        "EXPO_PUBLIC_SERVER_URL_APP": "https://api.northernexplorer.org"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
