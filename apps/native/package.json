{
	"name": "northernexplorer-native",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"android": "expo run:android",
		"build:android": "eas build --platform android --profile production",
		"build:ios": "eas build --platform ios --profile production",
		"build:web": "expo export --platform web",
		"clean": "rm -rf dist node_modules/.cache .expo ios android",
		"ios": "expo run:ios",
		"start": "expo start",
		"test:deps": "depcheck --specials=typescript --ignores=\"~,expo-splash-screen,expo-build-properties,react-native-worklets\"",
		"web": "expo start --web"
	},
	"dependencies": {
		"@aptabase/react-native": "^0.6.0",
		"@expo/vector-icons": "^15.0.2",
		"@maplibre/maplibre-react-native": "^11.3.10",
		"@northernexplorer/tools-web": "*",
		"@northernexplorer/types": "*",
		"@react-native-async-storage/async-storage": "2.2.0",
		"@react-native-community/netinfo": "12.0.1",
		"@reduxjs/toolkit": "^2.12.0",
		"expo": "~58.0.17",
		"expo-build-properties": "~58.0.11",
		"expo-camera": "~58.0.12",
		"expo-device": "~58.0.5",
		"expo-linking": "~58.0.14",
		"expo-location": "~58.0.18",
		"expo-router": "~58.0.25",
		"expo-splash-screen": "~58.0.11",
		"geojson": "^0.5.0",
		"maplibre-gl": "^5.24.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-map-gl": "^8.1.1",
		"react-native": "0.88.0",
		"react-native-device-info": "^15.0.2",
		"react-native-gesture-handler": "~3.3.0",
		"react-native-markdown-display": "^7.0.2",
		"react-native-purchases": "^10.4.4",
		"react-native-reanimated": "^4.7.1",
		"react-native-safe-area-context": "~5.10.1",
		"react-native-screens": "~4.30.0",
		"react-native-web": "^0.21.2",
		"react-native-worklets": "^0.13.0",
		"react-redux": "^9.3.0",
		"redux-persist": "^6.0.0",
		"supercluster": "^8.0.1",
		"use-supercluster": "^1.2.0"
	},
	"devDependencies": {
		"@types/react": "~19.3.0"
	}
}
