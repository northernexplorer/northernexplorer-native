{
  "name": "northernexplorer-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "native": "yarn workspace northernexplorer-native",
    "server": "yarn workspace northernexplorer-server",
    "start:android": "yarn workspace northernexplorer-native android",
    "start:ios": "yarn workspace northernexplorer-native ios",
    "start:migrate": "yarn workspace northernexplorer-migrate start",
    "start:web": "yarn workspace northernexplorer-native web",
    "start:server": "yarn workspace northernexplorer-server dev",
    "test:deps": "depcheck --specials=typescript --ignores=\"eslint-plugin-prettier,prettier,depcheck,@types/node,tsx,eslint-plugin-jsonc\" && yarn workspaces run test:deps",
    "test:format": "prettier . --check",
    "test:lint": "eslint .",
    "test:types": "tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "^8.61.1",
    "depcheck": "^1.4.7",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jsonc-eslint-parser": "^3.1.0",
    "prettier": "^3.8.4",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
