{
    "name": "northernexplorer-monorepo",
    "version": "1.0.0",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "build:migrate": "yarn workspace northernexplorer-migrate build",
        "build:server": "yarn workspace northernexplorer-server build",
        "build:tools": "yarn workspace @northernexplorer/tools build",
        "build:types": "yarn workspace @northernexplorer/types build",
        "build:web": "yarn workspace northernexplorer-native build:web",
        "dev:organize": "dev/organize.sh",
        "dev:setup": "dev/setup.sh",
        "dev:start": "dev/start.sh",
        "native": "yarn workspace northernexplorer-native",
        "server": "yarn workspace northernexplorer-server",
        "start:android": "yarn workspace northernexplorer-native android",
        "start:ios": "yarn workspace northernexplorer-native ios",
        "start:migrate": "yarn workspace northernexplorer-migrate start",
        "start:server": "yarn workspace northernexplorer-server dev",
        "start:web": "yarn workspace northernexplorer-native web",
        "test:deps": "depcheck --specials=typescript --ignores=\"sort-package-json,eslint-plugin-prettier,prettier,depcheck,@types/node,tsx,eslint-plugin-jsonc\" && yarn workspaces run test:deps",
        "test:format": "prettier . --check",
        "test:lint": "eslint .",
        "test:types": "tsc --build --force"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "8.59.0",
        "@typescript-eslint/parser": "^8.61.1",
        "depcheck": "^1.4.7",
        "eslint": "^9.24.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsonc": "^3.2.0",
        "eslint-plugin-prettier": "^5.5.6",
        "jsonc-eslint-parser": "^3.1.0",
        "prettier": "^3.8.4",
        "sort-package-json": "^4.0.0",
        "tsx": "^4.0.0",
        "typescript": "^6.0.3"
    }
}
